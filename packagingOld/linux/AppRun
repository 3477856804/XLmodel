#!/bin/sh
# AppImage 入口：定位自身目录并设置数据目录（可写）到用户家目录
HERE="$(dirname "$(readlink -f "$0")")"
export XIAOLING_HOME="${XIAOLING_HOME:-$HOME/.local/share/xiaoling}"
mkdir -p "$XIAOLING_HOME"
# 无独显时用 Mesa 软件 GL（llvmpipe + 关 JIT 优化，避免部分虚拟化 CPU 的非法指令）
export GALLIVM_PERF="${GALLIVM_PERF:-nopt}"
exec "$HERE/usr/bin/xiaoling/xiaoling" "$@"
