__pycache__/
*.pyc
# .venv 用不带斜杠的写法：既能忽略目录，也能忽略**指向别处 venv 的符号链接**
# （多份测试副本共用同一个环境时常用这种软链，带斜杠的 .venv/ 匹配不到链接本身）
.venv
build/
dist/
# PyInstaller 配置：打包/xiaoling.spec 是唯一需要入库的 spec，其余一律忽略
*.spec
!打包/xiaoling.spec
# 运行期产物（成长管线本地数据，不入库）
.star_core/growth/records.db
.star_core/growth/*.json
.star_core/growth/*.jsonl
数据/records/
数据/export.jsonl
我的小凌模型.zip
sounds/tool/*.tmp
# 本地机密 / 运行期配置：含 DeepSeek API Key，绝不入库
.env
.star_core/xiaoling_config.json
